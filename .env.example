# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG CHO 2 MÔI TRƯỜNG (DEV & PROD)
# 
# 1. Môi trường Phát triển (Dev):
#    Sao chép nội dung này vào tệp `.env.development.local` và điền DB Dev của Supabase.
#    Lệnh chạy dev: `npm run dev`
#
# 2. Môi trường Production tại máy (Prod Local Test):
#    Sao chép nội dung này vào tệp `.env.production.local` và điền DB Prod.
#
# 3. Môi trường Production trên Vercel:
#    Điền các biến dưới đây vào mục Settings -> Environment Variables trên Vercel Dashboard.
# ==============================================================================

# Database Connection (PostgreSQL on Supabase or Neon.tech)
# DATABASE_URL: Cổng 6543 (Transaction mode / PgBouncer pooler cho runtime Next.js serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Cổng 5432 (Session mode trực tiếp dành riêng cho Prisma migrate)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# NextAuth Authentication
# - Dev: http://localhost:3000
# - Prod: https://your-domain.vercel.app hoặc https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Chuỗi bí mật JWT ngẫu nhiên 32+ ký tự: `openssl rand -base64 32`
NEXTAUTH_SECRET="super-secret-jwt-key-for-elearning-platform-dev-mode-2026"

# Nhận diện môi trường ứng dụng
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"

# VietQR / Thông tin tài khoản ngân hàng chuyển khoản
NEXT_PUBLIC_BANK_ID="MB"
NEXT_PUBLIC_BANK_ACCOUNT_NO="0988888888"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="WORLD TRADING LAB"
NEXT_PUBLIC_APP_NAME="World Trading Lab"

# ==============================================================================
# CẤU HÌNH CÁC CỔNG THANH TOÁN (PAYMENT GATEWAYS)
# Các biến dưới đây là giá trị mặc định hệ thống. Admin cũng có thể tùy chỉnh
# trực tiếp từ Admin Dashboard (/admin/settings).
# ==============================================================================

# 1. CỔNG VIETQR TỰ ĐỘNG - PAYOS (Nội địa VN)
# Lấy từ: https://my.payos.vn/ -> Kênh thanh toán -> Thông tin kết nối
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# 2. CỔNG VIETQR TỰ ĐỘNG - SEPAY (Nội địa VN)
# Lấy từ: https://my.sepay.vn/ -> Tích hợp Webhook / API
SEPAY_API_KEY=""
SEPAY_ACCOUNT_NO=""

# 3. CỔNG QUỐC TẾ - PAYPAL (Mặc định)
# Lấy từ: https://developer.paypal.com/dashboard/applications/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_MODE="sandbox" # "sandbox" khi thử nghiệm, "live" khi chạy thật
USD_EXCHANGE_RATE="25400" # Tỷ giá quy đổi VND / USD

# 4. CỔNG QUỐC TẾ - STRIPE (Thẻ tín dụng - Tùy chọn)
# Lấy từ: https://dashboard.stripe.com/apikeys & webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 5. CỔNG TIỀN MÃ HÓA THỦ CÔNG - CRYPTO USDT (BEP20 & TRC20)
# Để trống nếu chưa kích hoạt ví; điền địa chỉ ví nhận USDT để kích hoạt
NEXT_PUBLIC_CRYPTO_BEP20_ADDRESS=""
NEXT_PUBLIC_CRYPTO_TRC20_ADDRESS=""

# Google Social OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dịch vụ gửi Email (Resend API Key)
# Nếu để trống trong môi trường DEV, hệ thống tự động in link và nội dung email ra Console
RESEND_API_KEY=""
EMAIL_FROM="World Trading Lab <onboarding@resend.dev>"

# Cấu hình xác thực email khi đăng ký mới (true / false)
REQUIRE_EMAIL_VERIFICATION="false"

# Khóa bí mật bảo vệ API Cron (VD: gửi email nhắc nhở học viên 5 ngày không học)
CRON_SECRET="wtl-cron-secret-key-32chars-for-dev-2026"

# ==============================================================================
# CẤU HÌNH LƯU TRỮ S3 (ẢNH BÌA & TÀI LIỆU ĐÍNH KÈM / VIDEO KHÓA HỌC)
# Hệ thống hỗ trợ tương thích 100% chuẩn S3 API (Cloudflare R2, AWS S3, MinIO).
# MẶC ĐỊNH: Cloudflare R2 (Miễn phí 10GB & Miễn phí 100% băng thông tải về)
# ==============================================================================

# --- [TÙY CHỌN 1: MẶC ĐỊNH] CLOUDFLARE R2 OBJECT STORAGE ---
# Lấy từ Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="elearning-media"
# Domain public cho ảnh bìa & tài nguyên public (Custom Domain gắn với R2 bucket hoặc pub-xxx.r2.dev)
S3_PUBLIC_URL="https://pub-<ACCOUNT_HASH>.r2.dev"
# Giới hạn kích thước file đính kèm (MB) - Mặc định 50MB
MAX_ATTACHMENT_SIZE_MB="50"
# Giới hạn kích thước video tải lên (MB) - Mặc định 1024MB (1GB)
MAX_VIDEO_SIZE_MB="1024"
# Thời gian hết hạn của link xem video có chữ ký bảo mật S3 (Giây) - Mặc định 7200 giây (2 tiếng)
VIDEO_PRESIGNED_EXPIRES_SECONDS="7200"

# --- [TÙY CHỌN 2: DỰ PHÒNG] AMAZON WEB SERVICES S3 (AWS S3) ---
# Để chuyển sang dùng AWS S3, bỏ chú thích các biến dưới đây và chú thích mục Cloudflare R2 ở trên:
# S3_ENDPOINT="" # AWS S3 dùng endpoint chuẩn theo Region, để trống
# S3_REGION="ap-southeast-1" # Ví dụ: ap-southeast-1 (Singapore)
# S3_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
# S3_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# S3_BUCKET_NAME="worldtradinglab-courses-storage"
# S3_PUBLIC_URL="https://worldtradinglab-courses-storage.s3.ap-southeast-1.amazonaws.com"
# MAX_ATTACHMENT_SIZE_MB="50"

