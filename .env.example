# ==========================================
# Database Connection
# ==========================================
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL on Supabase, Neon.tech, or Vercel Postgres):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require"

# ==========================================
# NextAuth Authentication
# ==========================================
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app or https://your-custom-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong 32+ character random secret for production: `openssl rand -base64 32`
NEXTAUTH_SECRET="super-secret-jwt-key-for-elearning-platform-dev-mode-2026"

# ==========================================
# VietQR / Bank Transfer Payment Settings
# ==========================================
NEXT_PUBLIC_BANK_ID="MB"
NEXT_PUBLIC_BANK_ACCOUNT_NO="0988888888"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="WORLD TRADING LAB"
NEXT_PUBLIC_APP_NAME="World Trading Lab"

# ==========================================
# Payment Webhook (Optional: SePay / Casso)
# ==========================================
PAYMENT_WEBHOOK_API_KEY="sepay_webhook_secret_key_123"

# ==========================================
# Email Notification (Optional: Resend)
# ==========================================
RESEND_API_KEY=""
