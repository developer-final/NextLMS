{
  "name": "elearning-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "ci": "npm run db:generate && npm run type-check && npm run lint && npm test",
    "db:push": "dotenv -e .env.development.local -- prisma db push",
    "db:push:prod": "dotenv -e .env.production.local -- prisma db push",
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv -e .env.development.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.development.local -- prisma migrate deploy",
    "db:migrate:deploy:prod": "dotenv -e .env.production.local -- prisma migrate deploy",
    "db:migrate:reset": "dotenv -e .env.development.local -- prisma migrate reset -f",
    "db:migrate:status": "dotenv -e .env.development.local -- prisma migrate status",
    "db:seed": "dotenv -e .env.development.local -- node prisma/seed.js",
    "db:seed:prod": "dotenv -e .env.production.local -- node prisma/seed.js",
    "db:studio": "dotenv -e .env.development.local -- prisma studio",
    "db:studio:prod": "dotenv -e .env.production.local -- prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@paypal/react-paypal-js": "^10.4.0",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.15.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.0.3",
    "next-auth": "^4.24.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.0",
    "stripe": "^22.6.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
