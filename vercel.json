{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/study-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
